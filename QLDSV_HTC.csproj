<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>QLDSV_HTC</RootNamespace>
    <AssemblyName>QLDSV_HTC</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="GUIMage\LogoUTC.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyLogoToResources" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(ProjectDir)Resources\img" Condition="!Exists('$(ProjectDir)Resources\img')" />
    <Copy SourceFiles="$(ProjectDir)GUIMage\LogoUTC.png" DestinationFolder="$(ProjectDir)Resources\img\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)GUIMage\LogoUTC.png')" />
  </Target>

</Project>
